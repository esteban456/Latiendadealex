# Puerto del servidor local
PORT=3000

# Panel privado para administrar el catálogo en /admin.html (servidor local Node)
ADMIN_PASSWORD=cambia-esta-clave-por-una-larga-y-unica
# DATA_DIR solo lo usa el servidor local Node. Cloudflare usa D1 e ImageKit.
DATA_DIR=

# Google Identity Services (Client ID público de la aplicación web)
GOOGLE_CLIENT_ID=484973380597-2ava9io0f4mf34fplkfin6j29uplh6uf.apps.googleusercontent.com
# IDs OAuth públicos para habilitar estos proveedores externos (opcionales)
APPLE_CLIENT_ID=
MICROSOFT_CLIENT_ID=
# Define un secreto aleatorio largo en producción para firmar las sesiones
GOOGLE_SESSION_SECRET=

# ImageKit (solo necesario en Cloudflare Pages)
# Copia el URL endpoint público de Developer Options, por ejemplo https://ik.imagekit.io/TU_ID
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/eayqxn9lnz
# Carpeta de los productos que cargaste en ImageKit
IMAGEKIT_FOLDER=/Latiendadealex
# En Cloudflare guarda la Private Key como Secret; no la pongas aquí ni en el navegador.
IMAGEKIT_PRIVATE_KEY=

# URL publica de la tienda (usada por Mercado Pago para los retornos y el webhook)
# Debe ser https y ser la URL real: Mercado Pago no acepta http en produccion.
PUBLIC_URL=https://latd-alex.com

# Mercado Pago (dejalo vacio para trabajar en modo demo)
MP_ACCESS_TOKEN=
# Tus integraciones > Webhooks > "Mostrar clave secreta"
MP_WEBHOOK_SECRET=
# true = redirige al checkout de pruebas (usuarios de test de Mercado Pago).
# Ponlo en false cuando la cuenta ya cobre de verdad, si no los clientes reales
# verian el sandbox y no podrian pagar.
MP_SANDBOX=true
# Maximo de cuotas que se ofrecen en el checkout
MP_INSTALLMENTS=12

# Datos de la tienda
STORE_NAME=La Tienda de Alex
STORE_WHATSAPP=573124885850
STORE_EMAIL=ventas@latd-alex.com
STORE_ADDRESS=

# Envio
FREE_SHIPPING_FROM=300000
SHIPPING_FLAT=25000
