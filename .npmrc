# Cloudflare Pages ejecuta `npm clean-install` antes de publicar.
# onnxruntime-node 1.21.0 intenta descargar binarios CUDA que hoy devuelven 404;
# la tienda no usa GPU, así que omitimos esa descarga (los binarios CPU ya vienen incluidos).
onnxruntime-node-install=skip
onnxruntime-node-install-cuda=skip
